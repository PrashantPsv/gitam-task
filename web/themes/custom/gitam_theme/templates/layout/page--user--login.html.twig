<style>
    /* Page Centering Wrapper */
body {
  margin: 0;
  padding: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  background-color: #f8fafc;
}

.centered-login-wrapper {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  box-sizing: border-box;
}

/* GITAM Login Card */
.gitam-login-card {
    background: #004740;
    width: 100%;
    max-width: 380px;
    padding: 40px 32px;
    border-radius: 12px;
    border: 1.5px solid #006d5b;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
    box-sizing: border-box;
    text-align: center;
    color: white;
}

/* Logo Styling */
.login-logo {
  margin-bottom: 30px;
}

.login-logo img {
  max-width: 160px;
  height: auto;
}

/* Form Fields */

input {
  width: 100%;
  margin-bottom: 20px;
  padding: 10px 0;
  
  text-align: center;
  font-size: 0.95rem;
  color: #333333;
  outline: none;
}

input::placeholder {
  color: #64748b;
  font-size: 0.88rem;
}

input:focus {
  border-bottom-color: #006d5b;
}

/* CAPTCHA Styling */
.captcha-wrapper {
  margin: 20px 0 15px 0;
}

.captcha-image-box {
  display: inline-block;
  background: #f1f5f9;
  border: 1px dashed #94a3b8;
  padding: 8px 24px;
  border-radius: 4px;
  letter-spacing: 6px;
  font-weight: 700;
  font-size: 1.2rem;
  color: #0f172a;
  user-select: none;
  cursor: pointer;
}

.captcha-refresh-text {
  display: block;
  font-size: 0.72rem;
  color: #64748b;
  margin-top: 6px;
}

/* Login Button */
.btn-gitam-login {
  width: 100%;
  max-width: 120px;
  background-color: #006d5b; /* Official GITAM Teal */
  color: #ffffff;
  border: none;
  padding: 10px 0;
  border-radius: 4px;
  font-size: 0.88rem;
  font-weight: 600;
  letter-spacing: 1px;
  cursor: pointer;
  margin-top: 10px;
  transition: background-color 0.2s ease;
}

.btn-gitam-login:hover {
  background-color: #005244;
}

/* Footer Links */
.login-links {
  margin-top: 24px;
  display: flex;
  justify-content: space-between;
  gap: 12px;
}

.login-links a {
  color: #006d5b;
  font-size: 0.82rem;
  text-decoration: none;
  font-weight: 500;
}

.login-links a:hover {
  text-decoration: underline;
}
input[type="submit"] {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 32px;
    background: #f4e4c9;
    color: var(--gd) !important;
    font-size: 15px;
    font-weight: 700;
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
}
</style>
<div class="centered-login-wrapper">
  <div class="gitam-login-card">
    
    <!-- Header Logo -->
    <div class="login-logo">
      <img src="{{ base_path ~ directory }}/images/gitam-logo-basic-horizontal-reverse.png" alt="GITAM Logo">
    </div>

    {{ page.content }}
  </div>
</div>