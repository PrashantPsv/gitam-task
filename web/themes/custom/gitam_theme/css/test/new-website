    <script>
        (function () {
            // ── DISCIPLINE DATA ───────────────────────────────────────────────
            // Ordered so the strongest disciplines start at/near the center.
            // photo: background-image URL (leave "" for the gradient placeholder).
            // video: YouTube watch/embed URL or an .mp4 path (leave "" for now).
            var DISC_DATA = [{
                    tag: "School of Business",
                    title: "The Art of Communication",
                    director: "Dr. Ananya Sharma",
                    role: "Director, Business Communication",
                    accent: "#6b6258",
                    photo: "",
