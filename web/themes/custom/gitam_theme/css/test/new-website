                    accent: "#3a4a52",
                    photo: "",
                    video: ""
                },
                {
                    tag: "School of Business",
                    title: "Strategic HR Management",
                    director: "Dr. Kavya Nair",
                    role: "Director, Human Resources",
                    accent: "#2b3a30",
                    photo: "",
                    video: ""
                },
                {
                    tag: "School of Business",
                    title: "Master the Art of Decision Making",
                    director: "Dr. Vikram Rao",
                    role: "Director, Strategy & Leadership",
                    accent: "#4a3f33",
                    photo: "",
                    video: ""
                },
                {
                    tag: "School of Business",
                    title: "Tech in Finance",
                    director: "Dr. Arjun Kapoor",
                    role: "Director, Finance & FinTech",
                    accent: "#5a4a3a",
                    photo: "",
                    video: ""
                },
                {
                    tag: "School of Business",
                    title: "The Science of Modern Sales",
                    director: "Dr. Neha Iyer",
                    role: "Director, Marketing & Sales",
                    accent: "#6b5042",
                    photo: "",
                    video: ""
                },
                {
                    tag: "School of Business",
                    title: "Family Business Management",
                    director: "Dr. Sanjay Gupta",
                    role: "Director, Family Enterprise",
                    accent: "#33402f",
                    photo: "",
                    video: ""
                },
                {
                    tag: "School of Business",
                    title: "Business in the Digital Era",
                    director: "Dr. Priya Menon",
                    role: "Director, Digital Transformation",
                    accent: "#243a3a",
                    photo: "",
                    video: ""
                }
            ];

            // GITAM mark shown top-left of each card.
            var LOGO_SRC = "images/applyloginimages/gitam-logo-basic-horizontal-reverse.png";

            var track = document.getElementById("discTrack");
            var dotsWrap = document.getElementById("discDots");
            var stage = document.getElementById("discStage");
            if (!track) return;

            var PLAY_SVG =
                '<svg viewBox="0 0 18 18" fill="none"><path d="M4 2.5l12 7-12 7V2.5z" fill="rgba(255,255,255,0.95)"/></svg>';

            // Build cards
            var cards = DISC_DATA.map(function (d, i) {
                var card = document.createElement("div");
                card.className = "disc-card";
                card.setAttribute("data-index", i);
                if (d.video) card.setAttribute("data-video", d.video);
                var photoStyle = d.photo ?
                    'background-image:url(\'' + d.photo + '\')' :
                    'background:linear-gradient(155deg,' + d.accent + ' 0%, #0a1812 100%)';
                card.innerHTML =
                    '<div class="disc-card-photo" style="' + photoStyle + '"></div>' +
                    '<div class="disc-card-grad"></div>' +
                    '<div class="disc-card-top"><img src="' + LOGO_SRC + '" alt="GITAM"></div>' +
                    '<div class="disc-card-title">' + d.title + '</div>' +
                    '<div class="disc-card-meta"><strong>' + d.director + '</strong>' + d.role + '</div>' +
                    '<div class="disc-card-play">' + PLAY_SVG + '</div>';
                track.appendChild(card);
                return card;
            });

            // Build dots
            var dots = DISC_DATA.map(function (_, i) {
                var b = document.createElement("button");
                b.className = "disc-dot";
                b.type = "button";
                b.setAttribute("aria-label", "Go to discipline " + (i + 1));
                b.addEventListener("click", function () {
                    goTo(i, true);
                });
                dotsWrap.appendChild(b);
                return b;
            });

            var N = cards.length;
            var active = 0;
            var VISIBLE = 3; // cards visible on each side of center
            // Horizontal spacing scales with viewport so cards span the full width.
            function computeGap() {
                // Cards sit close together (slight overlap) so the centre pops forward.
                var w = stage.clientWidth || window.innerWidth;
                return Math.max(170, Math.min(232, w / 6.0));
            }
            var GAP = computeGap();

            function shortestOffset(i, center) {
                // circular distance so the carousel wraps seamlessly
                var raw = i - center;
                if (raw > N / 2) raw -= N;
                if (raw < -N / 2) raw += N;
                return raw;
            }

            function render() {
                cards.forEach(function (card, i) {
                    var off = shortestOffset(i, active);
                    var abs = Math.abs(off);
                    var isActive = off === 0;
                    card.classList.toggle("is-active", isActive);

                    if (abs > VISIBLE) {
                        card.style.opacity = "0";
                        card.style.pointerEvents = "none";
                        card.style.transform = "translateX(" + (off * GAP) + "px) scale(0.4)";
                        return;
                    }
                    var x = off * GAP;
                    var scale = isActive ? 1.16 : 1 - abs * 0.06;
                    var rotate = off === 0 ? 0 : (off > 0 ? -16 : 16);
                    var translateZ = isActive ? 60 : -abs * 36;
                    var brightness = isActive ? 1 : 0.42 - (abs - 1) * 0.08;

                    card.style.opacity = "1";
                    card.style.pointerEvents = "auto";
                    card.style.zIndex = String(100 - abs);
                    card.style.filter = "brightness(" + brightness + ")";
                    card.style.transform =
                        "translateX(" + x + "px) translateZ(" + translateZ + "px) " +
                        "rotateY(" + rotate + "deg) scale(" + scale + ")";
                });
                dots.forEach(function (d, i) {
                    d.classList.toggle("is-active", i === active);
                });
            }

            function goTo(i, userTriggered) {
                active = ((i % N) + N) % N;
                render();
                if (userTriggered) restart();
            }

            function next(user) {
                goTo(active + 1, user);
            }

            function prev(user) {
                goTo(active - 1, user);
            }

            // Recompute spacing on resize to keep the row full-bleed.
            window.addEventListener("resize", function () {
                GAP = computeGap();
                render();
            });

            // ── Auto-scroll: advance one card every ~2.8s ─────────────────────
            var timer = null;
            var STEP_MS = 2800;

            function start() {
                if (timer) return;
                timer = setInterval(function () {
                    next(false);
                }, STEP_MS);
            }

            function stop() {
                clearInterval(timer);
                timer = null;
            }

            function restart() {
                stop();
                start();
            }

            // Controls
            document.getElementById("discNext").addEventListener("click", function () {
                next(true);
            });
            document.getElementById("discPrev").addEventListener("click", function () {
                prev(true);
            });

            // Pause on hover / focus so users can read & click
            stage.addEventListener("mouseenter", stop);
            stage.addEventListener("mouseleave", start);
            stage.addEventListener("focusin", stop);
            stage.addEventListener("focusout", start);

            // Card click: center it, or open its video if already centered
            cards.forEach(function (card) {
                card.addEventListener("click", function () {
                    var i = parseInt(card.getAttribute("data-index"), 10);
                    if (i !== active) {
                        goTo(i, true);
                        return;
                    }
                    openVideo(card.getAttribute("data-video"), DISC_DATA[i].title);
                });
            });

            // ── Video lightbox ────────────────────────────────────────────────
            var lb = document.getElementById("discLightbox");
            var lbFrame = document.getElementById("discLightboxFrame");

            function toEmbed(url) {
                if (!url) return null;
                var yt = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/))([\w-]{11})/);
                if (yt) return "https://www.youtube.com/embed/" + yt[1] + "?autoplay=1&rel=0";
                return null;
            }

            function openVideo(url, title) {
                stop();
                var embed = toEmbed(url);
                if (embed) {
                    lbFrame.innerHTML = '<iframe src="' + embed +
                        '" allow="autoplay; encrypted-media; fullscreen" allowfullscreen></iframe>';
                } else if (url) {
                    lbFrame.innerHTML = '<video src="' + url + '" controls autoplay playsinline></video>';
                } else {
                    lbFrame.innerHTML = '<div class="disc-lightbox-placeholder">Video for "' + title +
                        '" coming soon.</div>';
                }
                lb.hidden = false;
                document.body.style.overflow = "hidden";
            }

            function closeVideo() {
                lb.hidden = true;
                lbFrame.innerHTML = "";
                document.body.style.overflow = "";
                start();
            }
            document.getElementById("discLightboxClose").addEventListener("click", closeVideo);
            lb.addEventListener("click", function (e) {
                if (e.target === lb) closeVideo();
            });
            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape" && !lb.hidden) closeVideo();
            });

            // ── Init (respect reduced-motion) ─────────────────────────────────
            render();
            var prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            if (!prefersReduced) {
                if ("IntersectionObserver" in window) {
                    var io = new IntersectionObserver(function (entries) {
                        entries.forEach(function (en) {
                            en.isIntersecting ? start() : stop();
                        });
                    }, {
                        threshold: 0.2
                    });
                    io.observe(document.getElementById("sec-disciplines"));
                } else {
                    start();
                }
            }
        })();
    </script>

