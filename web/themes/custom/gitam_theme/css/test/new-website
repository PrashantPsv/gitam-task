    <script>
        (function () {
            const cards = document.querySelectorAll(".ec");
            const touchMq = window.matchMedia("(hover: none), (max-width: 600px)");

            function isTouchMode() {
                return touchMq.matches;
            }

            cards.forEach((card) => {
                card.addEventListener("click", (e) => {
                    if (!isTouchMode()) return;
                    e.stopPropagation();
                    const open = card.classList.contains("is-revealed");
                    cards.forEach((c) => c.classList.remove("is-revealed"));
                    if (!open) card.classList.add("is-revealed");
                });
            });

            document.addEventListener("click", (e) => {
                if (!isTouchMode()) return;
                if (!e.target.closest(".ec")) {
                    cards.forEach((c) => c.classList.remove("is-revealed"));
                }
            });

            touchMq.addEventListener("change", () => {
                cards.forEach((c) => c.classList.remove("is-revealed"));
            });
        })();
    </script>

