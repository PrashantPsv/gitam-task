# ==============================================================================
# Composer Dependencies
# ==============================================================================
# Ignore the vendor directory and core files managed by Composer
/vendor/
/web/core/

# Ignore contributed modules, themes, and profiles managed by Composer
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/

# ==============================================================================
# Site-Specific Configuration & Sensitive Files
# ==============================================================================
# NEVER commit database credentials or environment-specific files
/web/sites/*/settings.local.php
/web/sites/*/services.local.yml

# Optional: If you use environment variable files
.env
.env.local

# Keep the main settings.php file in git but ignore it if you prefer to set it up per environment.
# (Uncomment the line below if you do not want to track settings.php at all)
# /web/sites/*/settings.php

# ==============================================================================
# User-Generated Content & Uploads
# ==============================================================================
# Ignore public, private, and temporary files uploaded via the UI
/web/sites/*/files/
/web/sites/*/private/

# ==============================================================================
# Drupal Cache & Temporary Artifacts
# ==============================================================================
/web/sites/*/translations/
/web/sites/*/tmp/
/web/sites/*/cache/

# ==============================================================================
# Development Tools & System Files
# ==============================================================================
# Drush lock files
/.drush-lock-update

# macOS files
.DS_Store

# IDE and Editor settings
/.idea/
/.vscode/
*.swp
*.bak